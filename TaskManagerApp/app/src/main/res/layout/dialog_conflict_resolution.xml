<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phát hiện xung đột dữ liệu!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/status_failed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Công việc này đã bị thay đổi đồng thời trên thiết bị này và trên máy chủ. Vui lòng chọn phiên bản bạn muốn giữ lại:"
            android:textSize="14sp"
            android:textColor="#555555" />

        <!-- Local Version Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/status_pending"
            app:cardBackgroundColor="@color/status_pending_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Bản Cục Bộ (Local - Thiết bị này)"
                    android:textStyle="bold"
                    android:textColor="@color/status_pending" />

                <TextView
                    android:id="@+id/tvConflictLocalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tiêu đề: ..."
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConflictLocalDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mô tả: ..." />

                <TextView
                    android:id="@+id/tvConflictLocalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:text="Cập nhật lúc: ..." />

                <Button
                    android:id="@+id/btnKeepLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Giữ bản Cục Bộ này" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Server Version Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/status_syncing"
            app:cardBackgroundColor="@color/status_syncing_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️ Bản Máy Chủ (Server Cloud)"
                    android:textStyle="bold"
                    android:textColor="@color/status_syncing" />

                <TextView
                    android:id="@+id/tvConflictServerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tiêu đề: ..."
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConflictServerDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mô tả: ..." />

                <TextView
                    android:id="@+id/tvConflictServerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:text="Cập nhật lúc: ..." />

                <Button
                    android:id="@+id/btnKeepServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lấy bản Máy Chủ" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>